# Copy this file to .env and fill it in. NEVER commit the real .env.
# The .gitignore already blocks .env so your secrets stay local.

# The 3x-ui panel URL printed at the end of bootstrap.sh.
# Looks like: http://YOUR_SERVER_IP:PANELPORT/RANDOMPATH
# This is a SECRET (the random path is part of the auth). Treat it like a password.
ICEVPN_PANEL="http://YOUR_SERVER_IP:PANELPORT/REPLACE_WITH_PANEL_PATH"

# The API token you mint in the panel (Settings -> API tokens). A SECRET.
ICEVPN_TOKEN="REPLACE_WITH_API_TOKEN"

# The VLESS inbound id from the panel (usually 1).
ICEVPN_INBOUND=1

# Ports (must match bootstrap.sh)
SSH_PORT=22
VLESS_PORT=443

# Tier settings
FREE_TIER_GB=5
PAID_EXPIRY_DAYS=30

# REALITY target (a real site with TLS1.3 + H2, not hosted by your VPS provider)
TARGET=www.samsung.com